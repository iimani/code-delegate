# Copy to bench.local.env (gitignored) and adjust for this machine.
# Precedence: command-line flag > environment variable > bench.local.env > default.

# opencode models to test, comma-separated, cheapest first (the scorecard's
# suggested routing picks the first model that qualifies). Use exactly the
# names `opencode models` prints. "all" means every listed model, and shell-style
# patterns expand against that list in its order, e.g. BENCH_MODELS=ollama/*
# compare skips models that fail doctor's tool-call probe (--include-no-tools keeps them).
# Home lab example:    BENCH_MODELS=ollama/qwen2.5-coder:14b,ollama/qwen3-coder:30b
# Company example:     BENCH_MODELS=sovereign/some-coder-model,sovereign/some-large-model
BENCH_MODELS=

# Repetitions per task/condition/model cell. Below 3 the report flags low confidence.
BENCH_REPS=3

# Restrict tasks (slugs or number prefixes), e.g. BENCH_TASKS=01,04
# BENCH_TASKS=

# Per-run timeout in seconds (default: each task's task.yaml value).
# BENCH_TIMEOUT=900

# bridge.sh stall timeout for delegates (seconds without log output).
# Raise for large remote models that are slow to produce their first token.
# BENCH_STALL_TIMEOUT=600

# Seconds to wait for each model's doctor ping (first load of a big model can be slow).
# BENCH_PING_TIMEOUT=300

# Orchestrator model passed to `claude --model` (default: the CLI's default).
# Keep it fixed across runs you want to compare.
# BENCH_ORCHESTRATOR_MODEL=

# How runs are isolated from your personal Claude setup:
#   auto (default)   try cli-login, fall back to isolated-config
#   cli-login        your normal `claude` login, personal settings/CLAUDE.md/plugins excluded
#   isolated-config  empty CLAUDE_CONFIG_DIR per run; needs ANTHROPIC_API_KEY,
#                    CLAUDE_CODE_OAUTH_TOKEN (claude setup-token) or Bedrock/Vertex env vars
# BENCH_ISOLATION=auto

# Let bridge.sh auto-route instead of pinning delegates to opencode (true/false).
# BENCH_ALLOW_CLAUDE_DELEGATE=false

# Instructions appended to the orchestrator's system prompt in with-delegation runs.
# BENCH_DIRECTIVE_FILE=/path/to/directive.md

# Alternative CLI binaries.
# BENCH_CLAUDE_BIN=claude
# BENCH_OPENCODE_BIN=opencode
