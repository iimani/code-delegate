{
  "name": "code-delegate",
  "version": "2.0.1",
  "description": "Offload token-heavy coding tasks to local or cloud AI agents — free via local LLMs (OpenCode + Ollama/LM Studio) or paid via Claude/Codex. Parallel dispatch, stall detection, test gates, review-before-merge.",
  "author": {
    "name": "Ismail Imani",
    "email": "anthropic@iimani.ch"
  },
  "homepage": "https://github.com/iimani/code-delegate",
  "repository": "https://github.com/iimani/code-delegate",
  "license": "MIT",
  "keywords": [
    "delegation",
    "worktree",
    "multi-backend",
    "parallel-agents",
    "parallel-execution",
    "opencode",
    "codex",
    "local-llm",
    "ollama",
    "lm-studio",
    "lmstudio",
    "code-generation",
    "subagent",
    "free"
  ],
  "mcpServers": {
    "code-delegate": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/server.py"
      ],
      "alwaysLoad": true
    }
  }
}
